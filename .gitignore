# ── 模型权重与数据（体积大，走 W&B artifact，不进 git）
*.pt
*.pth
*.ckpt
checkpoints/
remote_checkpoints/
output/
manifests/
runs/
wandb/

# ── 日志
logs/
*.log
profiles/

# ── 凭据（绝不提交）
.env
.env.*
.secrets/
*.netrc
!.env.example

# ── 环境与缓存
.venv/
venv/
__pycache__/
*.py[cod]
*.so
.upload_cache/
.uploaded_ckpts.json*

# ── 数据集元数据压缩包
*.tar.zst
*.tar.gz
*.zst
*.sha256
# 例外：WenetSpeech M 的下载清单/manifest（39MB），没有它 download_wenetspeech_m_official.sh
# 跑不起来，而它又无法从公开源重新生成，必须随仓库走。
!scripts/download/wenet_m_metadata.tar.zst

# ── 编辑与备份产物
*.bak
*.bak[0-9]
*.tmp
_pre_merge_backup_*/

# ── 评测产物
# 测试 manifest 可由 scripts/build_test_manifests.py 重新生成（含绝对路径，14MB）
manifests_test/
# 逐字对齐 dump 太大（单文件 6MB），报告 JSON 照常提交
eval/align_*.json
